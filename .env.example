APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./ai_automation.db

# Switch to sdk only on a runner with Codex authentication available.
CODEX_BACKEND=stub
CODEX_MODEL=
CODEX_API_KEY=
CODEX_WORKSPACE_ROOT=./workspaces
CODEX_DEFAULT_WORKSPACE=default

# OpenAI Agents SDK reads OPENAI_API_KEY from the runtime environment.
# Never commit a real key to this file or the repository.
OPENAI_API_KEY=
INVESTMENT_AGENT_MODEL=
INVESTMENT_AGENT_MAX_TURNS=6
